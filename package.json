{
  "name": "@beeper/mcp-remote",
  "version": "0.1.1",
  "description": "Beeper Desktop's MCP server for stdio clients, packaged as the Claude Desktop extension",
  "keywords": [
    "mcp",
    "stdio",
    "beeper",
    "chat",
    "messages"
  ],
  "author": "Beeper <support@beeper.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beeper/mcp-remote.git"
  },
  "homepage": "https://www.beeper.com/mcp",
  "documentation": "https://developers.beeper.com/desktop-api/mcp",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/proxy.js",
  "bin": {
    "beeper-desktop-mcp": "dist/proxy.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prebuild": "rimraf dist dist-mcpb BeeperDesktop.dxt",
    "build": "bun build.ts",
    "postbuild": "node build-mcpb.js && dxt pack dist-mcpb BeeperDesktop.dxt",
    "check": "prettier --check . && tsc",
    "lint-fix": "prettier --check . --write"
  },
  "devDependencies": {
    "@anthropic-ai/dxt": "0.2.6",
    "@types/node": "^22.13.10",
    "bun": "^1.1.0",
    "mcp-remote": "0.8.3",
    "prettier": "^3.5.3",
    "rimraf": "6.0.1",
    "typescript": "^5.8.2"
  }
}
